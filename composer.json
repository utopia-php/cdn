{
    "name": "utopia-php/cdn",
    "description": "CDN cache purge and certificate provider abstractions for Utopia PHP",
    "type": "library",
    "keywords": ["php", "cdn", "cache", "tls", "utopia", "utopia-php", "library"],
    "license": "MIT",
    "authors": [
        {
            "name": "Torsten Dittmann",
            "email": "torsten@appwrite.io"
        }
    ],
    "minimum-stability": "stable",
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "lint": "./vendor/bin/pint --test",
        "format": "./vendor/bin/pint",
        "analyse": "./vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=2G"
    },
    "autoload": {
        "psr-4": {
            "Utopia\\Cdn\\": "src/Cdn"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Utopia\\Tests\\Cdn\\": "tests/Cdn"
        }
    },
    "require": {
        "php": ">=8.1.0",
        "ext-curl": "*",
        "ext-json": "*",
        "utopia-php/fetch": "^0"
    },
    "require-dev": {
        "phpunit/phpunit": "11.*",
        "laravel/pint": "1.*",
        "phpstan/phpstan": "2.*"
    },
    "config": {
        "platform": {
            "php": "8.3"
        }
    }
}
